  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "Key Code: 7\n\nCrew Log: Nightcycle #1002\n\nThe Board of Trustees has
    begun to question our true intentions regarding I.O.T.A. Even with my presentation,
    it seems that I've only brought about more questions that even I don't fully
    know the answer to. Without proper clearance, I've no determinent information
    to give to the Trustees to keep their confidence. \n\nMy meetings with the Board
    feel more like appeasement, like keeping them involved is somehow influencing
    the direction of the project. It feels like a delay tactic more than anything.
    I should go talk with the Director next nightcycle. \n\nEnd log."
